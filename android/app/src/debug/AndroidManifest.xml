<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The Flutter tool needs INTERNET for hot reload and breakpoints -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Never granted by install; grant over adb so the app can restart its own accessibility service. Debug only: Play would flag it -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <application>
        <receiver android:name=".DebugReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.lebaaar.doomwalk.DEBUG_WALK"/>
                <action android:name="com.lebaaar.doomwalk.DEBUG_SCROLL"/>
                <action android:name="com.lebaaar.doomwalk.DEBUG_DUMP"/>
                <action android:name="com.lebaaar.doomwalk.DEBUG_RESET"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
